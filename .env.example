# ══════════════════════════════════════════════════════════════════════════════
# GameVault E-Commerce Platform — Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in actual values for local development
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gamevault
POSTGRES_USER=gamevault
POSTGRES_PASSWORD=changeme_postgres_password_min_16_chars

# Connection string (auto-constructed if not provided)
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Connection string (auto-constructed if not provided)
# REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a secure secret: openssl rand -base64 64
JWT_SECRET=changeme_jwt_secret_must_be_at_least_64_characters_long_for_security
JWT_ISSUER=gamevault-api
JWT_AUDIENCE=gamevault-clients
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ── Ollama (External LLM Service) ─────────────────────────────────────────────
# Ollama must be running externally (not in Docker Compose)
# For local development on macOS/Windows: http://host.docker.internal:11434
# For Linux: http://172.17.0.1:11434 or actual host IP
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=3
OLLAMA_SUMMARY_MIN_COMMENTS=3
OLLAMA_SUMMARY_MAX_TOKENS=500
OLLAMA_SUMMARY_JOB_INTERVAL_SECONDS=60

# ── API Configuration ─────────────────────────────────────────────────────────
API_BASE_URL=http://api:5000
API_PORT=5000
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# ── CORS Origins ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost

# ── Frontend Configuration ────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost/api/v1
VITE_STOREFRONT_URL=http://localhost:3000
VITE_ADMIN_URL=http://localhost:3001

# ── Nginx ─────────────────────────────────────────────────────────────────────
DOMAIN=localhost
NGINX_PORT=80
NGINX_SSL_PORT=443

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=Information
SERILOG_MIN_LEVEL=Information

# ── Seeding & Development ─────────────────────────────────────────────────────
AUTO_MIGRATE=true
AUTO_SEED=true
SEED_MOCK_COMMENTS=true
SEED_COMMENTS_PER_PRODUCT=15

# ── Performance & Caching ─────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_DEFAULT_EXPIRY_MINUTES=30
DB_CONNECTION_POOL_SIZE=100

# ── Security ──────────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=10
ENABLE_SWAGGER=true
ENABLE_CORS=true

# ══════════════════════════════════════════════════════════════════════════════
# Production Overrides (for docker-compose.prod.yml)
# ══════════════════════════════════════════════════════════════════════════════
# ASPNETCORE_ENVIRONMENT=Production
# AUTO_MIGRATE=false
# AUTO_SEED=false
# ENABLE_SWAGGER=false
# LOG_LEVEL=Warning
# ══════════════════════════════════════════════════════════════════════════════
